# Copy this file to .streamlit/secrets.toml (it is git-ignored) for local use,
# or paste the same lines into Streamlit Cloud -> App settings -> Secrets.
# Add ONE or more keys; the app picks them up automatically. Leave all out for Demo mode.

ANTHROPIC_API_KEY = "your-anthropic-key"
# OPENAI_API_KEY    = "your-openai-key"
# GEMINI_API_KEY    = "your-gemini-key"
